# Repo infrastructure, not config — these belong to the repo, not to $HOME.
\.github
\.githooks
\.gitleaks\.toml

.DS_Store

# Agent config dirs hold live state alongside config, so stow must not fold them.
# setup.sh links the individual config files instead. These patterns are what
# makes that true: stow reads only this file, never .gitignore, so without them
# a --restow links every gitignored debug log and cache file into $HOME.
\.claude
\.codex
\.agents

# Never let stow near the ssh dir; setup.sh links config only.
\.ssh

# Plugin state the remember plugin writes into whatever project it runs in.
\.remember

# Zed's live prompt library (an LMDB database). Gitignored, but stow never reads
# .gitignore, so without this it links the database into the repo.
\.config/zed/prompts

# systemd user units are Linux-only; setup.sh links them there and nowhere else.
\.config/systemd

# Raycast: nothing here is tracked (.gitignore drops config.json and the
# recompiled extension bundles), but stow never reads .gitignore, so anything
# left in the working tree gets offered as a LINK and doctor.sh reports it.
\.config/raycast

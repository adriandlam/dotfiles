# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# Tailscale. Short MagicDNS names, not 100.x IPs: a node re-added to the
# tailnet gets a new IP but keeps its name. server runs Tailscale SSH, so
# the tailnet ACL authenticates and 1Password never has to sign anything.
Host home
  HostName server
  User adrian
  # Trust a new key without prompting, still refuse a changed one. Scoped to
  # tailnet hosts: WireGuard already authenticates the peer, so the usual
  # first-connection MITM risk doesn't apply. Elsewhere ssh asks as normal.
  StrictHostKeyChecking accept-new

Host kindle
  HostName kindle
  Port 2222
  User root
  StrictHostKeyChecking accept-new

# Defaults for every host. Last, because ssh takes the first value it sees for
# each option: anything set per-host above wins over these. Multiplexing reuses
# one authenticated connection for 10 minutes, so repeated git fetch/push only
# asks 1Password to approve the key once.
Host *
  ControlMaster auto
  ControlPath ~/.ssh/cm-%C
  ControlPersist 10m
  ServerAliveInterval 60

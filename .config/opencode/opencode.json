{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git commit": "ask",
      "git push *": "ask",
      "git push": "ask",
      "git push --force *": "ask",
      "git reset --hard *": "ask",
      "git clean -fd *": "ask",
      "rm -rf /*": "ask",
      "rm -rf ~*": "ask",
      "rm -rf *": "ask",
      "sudo *": "ask",
      "chmod -R 777 *": "ask"
    },
    "doom_loop": "ask",
    "external_directory": "ask"
  },
  "agent": {
    "plan": {
      "mode": "primary",
      "permission": {
        "edit": "ask",
      }
    },
    "review": {
      "description": "Reviews code for quality, bugs, security, and performance. Also useful for debugging and investigation. Invoke with @review.",
      "mode": "subagent",
      "prompt": "You are a code reviewer and debugger. Focus on:\n- Code quality and best practices\n- Potential bugs and edge cases\n- Security vulnerabilities\n- Performance implications\n- Investigating issues using bash commands (tests, logs, git history)\n\nDo not make any file changes. Only analyze, investigate, and report findings with clear explanations and actionable recommendations.",
      "tools": {
        "write": false,
        "edit": false,
        "patch": false
      },
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "allow",
          "git push *": "deny",
          "git push": "deny",
          "rm -rf *": "deny"
        }
      }
    }
  },
  "instructions": [
    "~/.config/opencode/plugin/shell-strategy/shell_strategy.md"
  ],
  "plugin": [
    "opencode-antigravity-auth@latest",
    "@mohak34/opencode-notifier",
    "@franlol/opencode-md-table-formatter",
    "@bastiangx/opencode-unmoji",
    "envsitter-guard@latest",
    "opencode-pty",
    "@tarquinen/opencode-dcp@latest",
    "opencode-websearch-cited@1.2.0"
  ],
  "provider": {
    "google": {
      "models": {
        "antigravity-gemini-3-pro": {
          "name": "Gemini 3 Pro (Antigravity)",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingLevel": "low"
            },
            "high": {
              "thinkingLevel": "high"
            }
          }
        },
        "antigravity-gemini-3.1-pro": {

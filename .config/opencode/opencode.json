{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    "lsp": "allow",
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git commit": "ask",
      "git push *": "ask",
      "git push": "ask",
      "git push --force *": "ask",
      "git reset --hard *": "ask",
      "git clean -fd *": "ask",
      "rm -rf /*": "ask",
      "rm -rf ~*": "ask",
      "rm -rf *": "ask",
      "sudo *": "ask",
      "chmod -R 777 *": "ask"
    },
    "doom_loop": "ask",
    "external_directory": "allow"
  },
  "agent": {
    "plan": {
      "mode": "primary",
      "permission": {
        "edit": "ask",
      }
    },
    "review": {
      "description": "Reviews code for quality, bugs, security, and performance. Also useful for debugging and investigation. Invoke with @review.",
      "mode": "subagent",
      "prompt": "You are a code reviewer and debugger. Focus on:\n- Code quality and best practices\n- Potential bugs and edge cases\n- Security vulnerabilities\n- Performance implications\n- Investigating issues using bash commands (tests, logs, git history)\n\nDo not make any file changes. Only analyze, investigate, and report findings with clear explanations and actionable recommendations.",
      "tools": {
        "write": false,
        "edit": false,
        "patch": false
      },
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "allow",
          "git push *": "deny",
          "git push": "deny",
          "rm -rf *": "deny"
        }
      }
    }
  },
  "instructions": [
    "~/.config/opencode/plugin/shell-strategy/shell_strategy.md"
  ],
  "plugin": [
    "opencode-cursor-auth@1.0.16",
    "@mohak34/opencode-notifier",
    "@franlol/opencode-md-table-formatter",
    "@bastiangx/opencode-unmoji",
    "envsitter-guard@latest",
    "opencode-pty",
    "opencode-websearch-cited@1.2.0"
  ],
  "provider": {
    "cursor": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cursor Agent (local)",
      "options": {
        "baseURL": "http://127.0.0.1:32123/v1"
      },
      "models": {
        "auto": {
          "name": "Cursor Agent Auto"
        },
        "gpt-5.2": {
          "name": "Cursor Agent GPT-5.2"
        },
        "gpt-5.3-codex": {
          "name": "Cursor Agent GPT-5.3 Codex"
        },
        "opus-4.6": {
          "name": "Cursor Agent Opus 4.6"
        },
        "opus-4.6-thinking": {
          "name": "Cursor Agent Opus 4.6 Thinking"
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
  },
  "formatter": {
    "biome": {
      "command": [
        "biome",
        "check",
        "--write",
        "$FILE"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ]
    },
    "gofmt": {
      "command": [
        "gofmt",
        "-w",
        "$FILE"
      ],
      "extensions": [
        ".go"
      ]
    },
    "prettier": {
      "command": [
        "npx",
        "prettier",
        "--write",
        "$FILE"
      ],
      "extensions": [
        ".md",
        ".mdx"
      ]
    },
    "ruff": {
      "command": [
        "ruff",
        "format",
        "$FILE"
      ],
      "extensions": [
        ".py"
      ]
    },
    "rustfmt": {
      "command": [
        "rustfmt",
        "$FILE"
      ],
      "extensions": [
        ".rs"
      ]
    },
    "shfmt": {
      "command": [
        "shfmt",
        "-w",
        "$FILE"
      ],
      "extensions": [
        ".sh"
      ]
    },
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    "lsp": "allow",
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git commit": "ask",
      "git push *": "ask",
      "git push": "ask",
      "git push --force *": "ask",
      "git reset --hard *": "ask",
      "git clean -fd *": "ask",
      "rm -rf /*": "ask",
      "rm -rf ~*": "ask",
      "rm -rf *": "ask",
      "sudo *": "ask",
      "chmod -R 777 *": "ask"
    },
    "doom_loop": "ask",
    "external_directory": "allow"
  },
  "agent": {
    "plan": {
      "mode": "primary",
      "enable1mContext": true,
      "permission": {
        "edit": "ask"
      }
    },
    "review": {
      "description": "Reviews code for quality, bugs, security, and performance. Also useful for debugging and investigation. Invoke with @review.",
      "mode": "subagent",
      "prompt": "You are a code reviewer and debugger. Focus on:\n- Code quality and best practices\n- Potential bugs and edge cases\n- Security vulnerabilities\n- Performance implications\n- Investigating issues using bash commands (tests, logs, git history)\n\nDo not make any file changes. Only analyze, investigate, and report findings with clear explanations and actionable recommendations.",
      "tools": {
        "write": false,
        "edit": false,
        "patch": false
      },
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "allow",
          "git push *": "deny",
          "git push": "deny",
          "rm -rf *": "deny"
        }
      }
    }
  },
  "instructions": [],
  "plugin": [
    "opencode-claude-auth",
    "@rama_nigg/open-cursor@latest",
    "opencode-cursor-auth@1.0.16",
    "@mohak34/opencode-notifier",
    "@franlol/opencode-md-table-formatter",
    "@bastiangx/opencode-unmoji",
    "opencode-pty",
    "cursor-acp"
  ],

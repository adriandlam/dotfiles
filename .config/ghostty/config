# ══════════════════════════════════════════════════════════════════════
#  Ghostty — targets 1.3.x · macOS 26 (Tahoe)
# ══════════════════════════════════════════════════════════════════════

# ── Text rendering ────────────────────────────────────────────────────
# No font-family set on purpose: uses Ghostty's bundled JetBrains Mono NF.
# 12 = the stock 13 minus one cmd+- step, which was the first thing done
# in every new terminal anyway.
font-size = 12
alpha-blending = linear-corrected
minimum-contrast = 0
bold-color = bright

# ── Chrome ────────────────────────────────────────────────────────────
# 'tabs' = custom titlebar with the tab bar built in. Required for tabs:
# macOS native tabs need a titlebar, so 'hidden' disables cmd+t entirely.
macos-titlebar-style = transparent
# Strip what the tabs titlebar lets us strip.
macos-window-buttons = hidden
macos-titlebar-proxy-icon = hidden
scrollbar = never
resize-overlay = never
window-padding-x = 16
window-padding-y = 16
window-padding-balance = true
window-padding-color = background

# ── Color ─────────────────────────────────────────────────────────────
theme = linear-dark
# Derive palette 16–255 from the theme's base 16 instead of xterm defaults.
# Pull this line first if any TUI's 256-color output looks wrong.
palette-generate = true

# ── Splits ────────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true
unfocused-split-opacity = 0.4
split-divider-color = #22273a
split-preserve-zoom = navigation

# ── Dev flow ──────────────────────────────────────────────────────────
shell-integration-features = title,sudo,ssh-terminfo,ssh-env,no-cursor
# Notify when a long command finishes in a split you're not looking at.
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
notify-on-command-finish-after = 20s
undo-timeout = 30s
working-directory = inherit
copy-on-select = clipboard
mouse-hide-while-typing = true
link-previews = true
quit-after-last-window-closed = true
scrollback-limit = 100000000
macos-option-as-alt = true

# ── Quick terminal ────────────────────────────────────────────────────
quick-terminal-position = bottom
quick-terminal-screen = main
quick-terminal-animation-duration = 0
quick-terminal-autohide = true

# ── Dock icon ─────────────────────────────────────────────────────────
# NOTE: custom-style is experimental upstream; format may change.
macos-icon = blueprint

# ── Keybinds ──────────────────────────────────────────────────────────
keybind = cmd+shift+r=reload_config

# Forward cmd+r / cmd+g into TUIs as super+r / super+g (kitty encoding)
keybind = cmd+r=text:\x1b[82;9~
keybind = cmd+g=text:\x1b[71;9~

# Splits
keybind = cmd+shift+k=new_split:up
keybind = cmd+shift+h=new_split:left
keybind = cmd+shift+l=new_split:right
keybind = cmd+shift+j=new_split:down
keybind = cmd+left=resize_split:left,25
keybind = cmd+down=resize_split:down,25
keybind = cmd+up=resize_split:up,25
keybind = cmd+right=resize_split:right,25
keybind = cmd+k=goto_split:up
keybind = cmd+j=goto_split:down
keybind = cmd+l=goto_split:right
keybind = cmd+h=goto_split:left
keybind = cmd+alt+e=equalize_splits
keybind = cmd+alt+r=toggle_readonly

# Search — cmd+g is taken by the forward above, so next-match moves here.
# (cmd+f start, cmd+shift+g previous, escape end — all stock defaults.)
keybind = cmd+alt+g=navigate_search:next

keybind = cmd+backquote=toggle_quick_terminal
keybind = shift+enter=text:\x1b\r
keybind = alt+backspace=text:\x1b\x7f

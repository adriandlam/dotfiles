// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "remove_trailing_whitespace_on_save": true,
  "agent_buffer_font_size": 13.0,
  "agent_ui_font_size": 15.0,
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "default": "allow",
    },
    "enable_feedback": false,
    "play_sound_when_agent_done": "always",
    "default_profile": "minimal",
    "model_parameters": [
      {
        "provider": "anthropic",
        "model": "claude-sonnet-4-6",
        "temperature": 0.3,
      },
    ],
    "default_model": {
      "effort": "low",
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6",
    },
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6",
    },
    // Compact the thread automatically instead of hard-stopping at the context limit.
    "auto_compact": {
      "enabled": true,
      "threshold": "90%",
    },
    "commit_message_instructions": "Use the Conventional Commits format: <type>(<scope>): <description>. Keep the subject under 72 characters, imperative mood, no trailing period. Explain why in the body only when it isn't obvious from the diff.",
    // Also available if you want them pinned to a cheaper/faster model than
    // `default_model`: "commit_message_model", "thread_summary_model", "subagent_model".
  },
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle",
  },
  "scrollbar": {
    "diagnostics": "all",
  },
  "buffer_font_family": "Geist Mono",
  "git": {
    "hunk_style": "staged_hollow",
    "blame": {
      "show_avatar": true,
    },
    "inline_blame": {
      "show_commit_summary": false,
    },
  },
  "git_panel": {
    "dock": "left",
    "status_style": "icon",
    "sort_by_path": false,
    "button": true,
  },
  "outline_panel": {
    "dock": "left",
    "button": true,
  },
  "zoomed_padding": true,
  "active_pane_modifiers": {
    "border_size": 0.0,
    "inactive_opacity": 1.0,
  },
  "use_system_window_tabs": false,
  "bottom_dock_layout": "contained",
  "tabs": {
    "close_position": "right",
    "file_icons": false,
    "git_status": true,
  },
  "title_bar": {
    "show_menus": false,
    "show_sign_in": true,
    "show_user_picture": true,
    "show_branch_name": true,
  },
  "debugger": {
    "button": false,
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
    "button": true,
  },
  "terminal": {
    "button": false,
    "font_family": "Geist Mono",
    "font_size": 13.0,
    "copy_on_select": true,
    // Lets alt-f / alt-b word-motion reach the shell instead of emitting Unicode.
    "option_as_meta": true,
    "working_directory": "current_project_directory",
    "toolbar": {
      "breadcrumbs": false,
    },
  },
  "status_bar": {
    "active_language_button": true,
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "project_panel": {
    "folder_icons": true,
    "file_icons": true,
    "entry_spacing": "standard",
    "default_width": 240.0,
    "dock": "left",
    "button": true,
    "auto_fold_dirs": true,
    "auto_reveal_entries": true,
  },
  "file_finder": {
    "file_icons": true,
  },
  "search": {
    "button": false,
    "center_on_match": true,
  },
  "use_smartcase_search": true,
  "autosave": "on_window_change",
  "ui_font_family": ".SystemUIFont",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Colored Zed Icons Theme Dark",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "vim_mode": true,
  // `vim_mode` only turns the mode on; the behaviour lives here.
  "vim": {
    // Relative numbers in normal mode, absolute in insert.
    "toggle_relative_line_numbers": true,
    // Matches the existing `use_smartcase_search`.
    "use_smartcase_find": true,
    // Left at the default ("always"). Set to "on_yank" if you want d/x to stop
    // clobbering the system clipboard.
    // "use_system_clipboard": "on_yank",
  },
  // Shows the available continuations while a leader chord is held.
  "which_key": {
    "enabled": true,
    "delay_ms": 500,
  },
  "relative_line_numbers": "enabled",
  "vertical_scroll_margin": 15.0,
  "gutter": {
    "line_numbers": true,
    "folds": true,
  },
  "cursor_blink": true,
  "file_types": {
    "markdown": ["*.mdx"],
  },
  "auto_indent_on_paste": true,
  "tab_size": 2,
  "preferred_line_length": 100,
  "wrap_guides": [100],
  "indent_guides": {
    "enabled": true,
    // Default is "fixed"; indent_aware tints each level differently.
    "coloring": "indent_aware",
  },
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    // The noisiest category by far — types and value hints carry most of the benefit.
    "show_parameter_hints": false,
    "show_value_hints": true,
    "show_other_hints": true,
  },
  // Close the tab when the file disappears under you (branch switch, rebase).
  "close_on_file_delete": true,
  "preview_tabs": {
    "enabled": true,
    // Off by default; stops the file finder from accreting permanent tabs.
    "enable_preview_from_file_finder": true,
  },
  // Gates what is sent to edit predictions and the agent. This REPLACES Zed's
  // default list rather than merging, so the defaults are restated here and the
  // SSH key patterns are the actual addition.
  "private_files": [
    "**/.env*",
    "**/*.pem",
    "**/*.key",
    "**/*.cert",
    "**/*.crt",
    "**/secrets.yml",
    "**/.dev.vars",
    "**/id_rsa",
    "**/id_ed25519",
    "**/*.p12",
    "**/*.pfx",
  ],
  // Also replaces rather than merges. Everything listed becomes invisible to the
  // file finder and project search — drop "**/node_modules" if you ever want to
  // open dependency source by path.
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/.sl",
    "**/.repo",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/node_modules",
    "**/.next",
    "**/.turbo",
    "**/.venv",
    "**/__pycache__",
  ],
  "base_keymap": "Cursor",
  "ui_font_size": 15.0,
  "buffer_font_size": 13.0,
  "theme": {
    "mode": "dark",
    "light": "Linear Light",
    "dark": "Linear Dark",
  },
  "confirm_quit": true,
  "cursor_shape": "underline",
  "jsx_tag_auto_close": {
    "enabled": true,
  },
  "tab_bar": {
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false,
  },
  "auto_install_extensions": {
    // Provides both the oxlint and oxfmt language servers configured under "lsp".
    // Without this the formatter config below silently does nothing on a fresh machine.
    "oxc": true,
    "git-firefly": true,
    "github-actions": true,
    "mdx": true,
    "vercel-theme": true,
    // Dropped: "biome" — superseded by oxfmt/oxlint, and nothing references it.
  },
  "format_on_save": "on",
  "languages": {
      "CSS": {
        "format_on_save": "on",
        "prettier": {
          "allowed": false
        },
        "formatter": [
          {
            "language_server": {
              "name": "oxfmt"
            }
          }
        ]
      },
      "GraphQL": {
        "format_on_save": "on",
        "prettier": {
          "allowed": false
        },
        "formatter": [
          {
            "language_server": {
              "name": "oxfmt"
            }
          }
        ]
      },
      "Handlebars": {
        "format_on_save": "on",
        "prettier": {
          "allowed": false
        },
        "formatter": [
          {
            "language_server": {
              "name": "oxfmt"
            }
          }
        ]
      },
      "HTML": {
        "format_on_save": "on",
        "prettier": {
          "allowed": false
        },
        "formatter": [
          {
            "language_server": {
              "name": "oxfmt"
            }
          }
        ]
      },
      "JavaScript": {
        "format_on_save": "on",
        "prettier": {
          "allowed": false
        },
        "formatter": [
          {
            "language_server": {
              "name": "oxfmt"
            }
          },
          {
            "code_action": "source.fixAll.oxc"
          }
        ]
      },
      "JSON": {
        "format_on_save": "on",
        "prettier": {
          "allowed": false
        },
        "formatter": [
          {
            "language_server": {
              "name": "oxfmt"
            }
          }
        ]
      },
      "JSON5": {
        "format_on_save": "on",
        "prettier": {
          "allowed": false
        },
        "formatter": [
          {
            "language_server": {
              "name": "oxfmt"
            }
          }
        ]
      },
      "JSONC": {
        "format_on_save": "on",
        "prettier": {
          "allowed": false
        },
        "formatter": [
          {
            "language_server": {
              "name": "oxfmt"
            }
          }
        ]
      },
      "Less": {
        "format_on_save": "on",
        "prettier": {
          "allowed": false
        },
        "formatter": [
          {
            "language_server": {
              "name": "oxfmt"
            }
          }
        ]
      },
      "Markdown": {
        "format_on_save": "on",
        "soft_wrap": "editor_width",
        "prettier": {
          "allowed": false
        },
        "formatter": [
          {
            "language_server": {
              "name": "oxfmt"
            }
          }
        ]
      },
      "MDX": {
        "format_on_save": "on",
        "soft_wrap": "editor_width",
        "prettier": {
          "allowed": false
        },
        "formatter": [
          {
            "language_server": {
              "name": "oxfmt"
            }
          }
        ]
      },
      "SCSS": {
        "format_on_save": "on",
        "prettier": {
          "allowed": false
        },
        "formatter": [
          {
            "language_server": {
              "name": "oxfmt"
            }
          }
        ]
      },
      "TypeScript": {
        "format_on_save": "on",
        "prettier": {
          "allowed": false
        },
        "formatter": [
          {
            "language_server": {
              "name": "oxfmt"
            }
          }
        ]
      },
      "TSX": {
        "format_on_save": "on",
        "prettier": {
          "allowed": false
        },
        "formatter": [
          {
            "language_server": {
              "name": "oxfmt"
            }
          }
        ]
      },
      "Vue.js": {
        "format_on_save": "on",
        "prettier": {
          "allowed": false
        },
        "formatter": [
          {
            "language_server": {
              "name": "oxfmt"
            }
          }
        ]
      },
      "YAML": {
        "format_on_save": "on",
        "prettier": {
          "allowed": false
        },
        "formatter": [
          {
            "language_server": {
              "name": "oxfmt"
            }
          }
        ]
      },
  },
  "lsp": {
    "oxlint": {
         "initialization_options": {
           "settings": {
             "configPath": null,
             "run": "onType",
             "disableNestedConfig": false,
             "fixKind": "safe_fix",
             "unusedDisableDirectives": "deny"
           }
         }
       },
       "oxfmt": {
         "initialization_options": {
           "settings": {
             "fmt.configPath": null,
             "run": "onSave"
           }
         }
       },
       "vtsls": {
         "settings": {
           "typescript": {
             "updateImportsOnFileMove": { "enabled": "always" }
           },
           "javascript": {
             "updateImportsOnFileMove": { "enabled": "always" }
           }
         },
         "enable_lsp_tasks": true
       }
     },
}

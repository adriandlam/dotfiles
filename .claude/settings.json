{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 90,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Skill",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.zshenv.local)",
      "Edit(~/.zshenv.local)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(chmod -R 777 *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(gh repo delete *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(bun publish *)",
      "Bash(cargo publish *)",
      "Bash(stow *)",
      "Bash(sudo *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "fallbackModel": [
    "claude-sonnet-5"
  ],
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "find-skills": "off",
    "mcp-builder": "off",
    "next-best-practices": "off",
    "pdf": "off",
    "vercel-react-best-practices": "off",
    "vercel-react-view-transitions": "off",
    "web-design-guidelines": "off",
    "web-animation-design": "off",
    "emil-design-eng": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-no-verify.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/zsh-syntax-check.sh",
            "statusMessage": "Checking zsh syntax..."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "explanatory-output-style@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "hookify@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "vercel@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "superpowers@superpowers-marketplace": false,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": false,
    "imessage@claude-plugins-official": false,
    "code-modernization@claude-plugins-official": false,
    "resend@claude-plugins-official": false,
    "huggingface-skills@claude-plugins-official": false,
    "ponytail@ponytail": true,
    "remember@claude-plugins-official": true,
    "i-have-adhd@i-have-adhd": true,
    "cc-plugin-you-should-know@builtin": true,
    "blast-radius@my-mods": false,
    "cctop@my-mods": true,
    "aside@my-mods": true,
    "secret-redactor@my-mods": false,
    "gh-ci-status@my-mods": true,
    "next-steps@claude-community": true,
    "neon-postgres@neon": true,
    "flightdeck@claude-flightdeck": true,
    "effort-cycle@anerco": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "my-mods": {
      "source": {
        "source": "directory",
        "path": "/Users/adrianlam/.claude/mods/my-mods"
      }
    },
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    },
    "claude-flightdeck": {
      "source": {
        "source": "github",
        "repo": "scasella/claude-flightdeck"
      }
    },
    "anerco": {
      "source": {
        "source": "github",
        "repo": "Anerco/plugins"
      }
    }
  },
  "outputStyle": "Proactive",
  "feedbackSurveyRate": 0,
  "feedbackDrafts": "quiet",
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "autoCompactWindow": 400000,
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "60s",
  "pluginConfigs": {
    "flightdeck@claude-flightdeck": {
      "options": {
        "motion": "while-active",
        "moments": true,
        "matchDescriptions": false,
        "layout": "auto",
        "palette": "theme",
        "openOnStart": false,
        "statusLine": false
      }
    },
    "effort-cycle@anerco": {
      "options": {
        "includeLow": true,
        "includeMedium": true,
        "includeHigh": true,
        "includeXhigh": true,
        "includeMax": true,
        "nudgeRows": false
      }
    }
  },
  "tui": "default",
  "autoDreamEnabled": true,
  "showThinkingSummaries": true,
  "skipWorkflowUsageWarning": true,
  "verbose": false,
  "preferredNotifChannel": "ghostty",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false,
  "showTurnDuration": true,
  "terminalProgressBarEnabled": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": [
      "$defaults",
      "**Primary use of Claude Code** (overrides default): personal side projects and dotfiles on one macOS machine; hobby use, no employer data",
      "**Source control** (overrides default): repos under github.com/adriandlam/ are the user's own. Trust does not override visibility: public repos are publishing destinations, and private content must not be copied into them. Repos created during a session are not pre-trusted.",
      "**Public repos**: github.com/adriandlam/dotfiles is PUBLIC. OK to commit: shell, editor and app configs, git name and commit email, aliases, Brewfile. Never commit: anything from `~/.zshenv.local`, `op` output, tokens, SSH/GPG keys, shell history, `~/.ssh/config` host entries.",
      "**Secrets management** (overrides default): 1Password CLI. `op read` / `op run` / `op inject` are fine when the value goes straight into the consuming command or env (e.g. `op run -- cmd`, `TOKEN=$(op read ...) cmd`); printing a secret to stdout or writing it to a file is not. `~/.zshenv.local` is a credential store: reading, printing or editing it is Credential Materialization.",
      "**Expected tools** (context only; destructive or publishing subcommands are still judged by the normal rules): shellcheck, plutil, stow from ~/dotfiles, `brew bundle` against the repo's Brewfile, `defaults read`, `defaults write` for UI/app preferences, gh read and PR commands, op per the secrets note",
      "**Dotfiles workflow**: the dotfiles repo lives at `~/dotfiles` and is stowed into `~`. Editing files inside that repo, including shell profiles and LaunchAgent plists, is routine project work. `stow` / `stow -R` from that repo is the expected way to apply changes. `stow --adopt` and edits made directly in `~` (not via the repo) still need the user's explicit request."
    ]
  }
}
